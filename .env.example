# Copy this file to .env.local and fill in the values.
# Everything starting with VITE_ ends up in the browser, so only put public keys here.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Public half of the VAPID key pair for push notifications.
# Generate with: npx web-push generate-vapid-keys   (see docs/NOTIFICATIONS.md)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Optional: Cloudflare Turnstile site key (public) for a bot check on sign in.
# Leave empty to turn it off. See README → Security → CAPTCHA.
VITE_TURNSTILE_SITE_KEY=

# Server-only values (no VITE_ prefix, so they never reach the browser).
# `npm run push:setup` sends them to Supabase secrets and fills in the last two.
VAPID_PRIVATE_KEY=your-vapid-private-key
CRON_SECRET=
VAPID_SUBJECT=mailto:you@example.com
